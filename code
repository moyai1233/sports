--   판정은 전부 서버: 고른 재료, 불 조절 최소 시간, 소스 붓기(누른 시간 × 속도 → 맵기 단계)
local cookRF = remotes:FindFirstChild("CookAct") or Instance.new("RemoteFunction"); cookRF.Name = "CookAct"; cookRF.Parent = remotes
