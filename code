					spawnFloorSpill(hit.Position)
					for _, m in ipairs(dirtyFolder:GetChildren()) do
						if m.Name == "FloorSpill" and m.PrimaryPart and (m.PrimaryPart.Position - hit.Position).Magnitude < 0.6 then tutSpill[plr] = m end
					end
					return true
				end
			end
			return false
		end
