local function serveTo(c, plr)
	local t = c.ticket
	if not t or t.state ~= "carried" or t.carrier ~= plr then return false end
	local bowl = t.bowl
	-- put the bowl on the table in front of the customer
	local seatPos, top = c.seatRec.seat.Position, c.seatRec.top
	local dir = (top.Position - seatPos) * Vector3.new(1, 0, 1)
	local p = seatPos + dir.Unit * math.min(2.4, dir.Magnitude)
	p = Vector3.new(p.X, top.Position.Y + top.Size.Y / 2 + 0.46, p.Z)
	bowl = placeOnTable(bowl, CFrame.new(p)); t.bowl = bowl
	c.tableBowl = bowl
	local tag = bowl.PrimaryPart:FindFirstChild("Tag"); if tag then tag:Destroy() end   -- no number tag on the table
	t.state = "done"
	releaseCarry(plr, t.id)
	refreshBoard()
	c.waitStage = nil
	if c.servePrompt then c.servePrompt:Destroy(); c.servePrompt = nil end
	-- 💀 해골 소스 (11/19): 한 입 먹고 불타면서 비명 지르며 뛰쳐나감. 보상 없음 (연출: SkullService)
	if t.skull then
		c.served = true; c.skullRun = true
		c.model:SetAttribute("TicketId", nil)
		local be = SS:FindFirstChild("SkullServed"); if be then be:Fire(c.model, plr) end
		-- (11/22) 서빙한 사람은 손님이 도망가도 정상 팁 (같이 일하는 알바생이 손해 보지 않게)
		reward(plr, "Serve", math.floor(C.TipMax * math.clamp(1 - (os.clock() - (c.foodWaitStart or os.clock())) / C.PatienceFood, 0, 1) * rushTipMult() / 10 + 0.5) * 10, "서빙", richMult(t)); pumpkinBonus(plr, t)
		notify(plr, "💀 해골 소스! 손님이 불타며 도망갔어요")
		task.spawn(function()
			task.wait(1.4)
			if not c.alive then return end
			sfx("Wrong", c.root, 0.6, 40)
			if c.hum then c.hum.WalkSpeed = 24 end
			leave(c, false)
		end)
		return true
	end
	-- tip: faster and correct = more
	local waited = os.clock() - (c.foodWaitStart or os.clock())
	local speed = math.clamp(1 - waited / C.PatienceFood, 0, 1)
	local tip = math.floor(C.TipMax * speed * (t.correct and 1 or C.WrongSpicePenalty) * rushTipMult() / 10 + 0.5) * 10
	reward(plr, "Serve", tip, "서빙", richMult(t)); pumpkinBonus(plr, t)
	if rushOn() then plr:SetAttribute("RushServed", (tonumber(plr:GetAttribute("RushServed")) or 0) + 1) end
	-- 리치맨/슈퍼 리치맨: 실제로 받은 팁(배율 적용)을 보여줌 (예전엔 배율 전 팁만 떠서 "리치맨이 200원 줌"으로 보였음) (11/18)
	local tipMult = richMult(t)
	if tip > 0 and tipMult > 1 then
		notify(plr, string.format(t.superRich and "👑 SUPER RICH MAN 팁! +%s원 (x%d)" or "💰 RICH MAN 팁! +%s원 (x%d)", tostring(tip * tipMult), tipMult))
	else
		notify(plr, tip > 0 and string.format("서빙 완료! 팁 +%s원", tostring(tip)) or "서빙 완료!")
	end
	if t.superRich then
		-- 👑 황금 팁: 룰렛 1회 + 전체 공지
		task.spawn(function()
			local bf = SS:FindFirstChild("GrantFreeSpins")
			if bf then pcall(function() bf:Invoke(plr, "original", 1) end) end
			notify(plr, "👑 SUPER RICH MAN의 황금 팁! 룰렛 1회를 받았어요")
		end)
		if announceRE then announceRE:FireAllClients({ kind = "rich", icon = "👑", title = "SUPER RICH MAN 만족!", text = string.format("%s님이 응대 성공! 보상 %d배 + 룰렛 1회", plr.DisplayName, C.SuperRichMult or 15) }) end
	end
	say(c, t.correct and "맛있겠다!" or "맵기가 좀 다른데...", false)
	if not t.correct then sfx("Wrong", c.root, 0.3, 40) end
	task.spawn(function()
		task.wait(2)
		if not c.alive then return end
		say(c, nil)
		c.model:SetAttribute("TicketId", nil)
		c.served = true
		-- a group starts eating only once everyone's food is on the table
		if c.group then
			local t0, said = os.clock(), false
			while c.alive and not c.leaving and os.clock() - t0 < 240 do
				local waiting = false
				for _, m in ipairs(c.group.members) do
					if m ~= c and m.alive and not m.leaving and not m.served then waiting = true end
				end
				if not waiting then break end
				if not said then
					said = true
					say(c, pick({ "다 나오면 같이 먹자", "기다릴게~", "먼저 안 먹어!" }), false)
					task.delay(2.5, function() if c.alive and not c.leaving and not c.model:GetAttribute("Eating") then say(c, nil) end end)
				end
				task.wait(0.5)
			end
			if not c.alive or c.leaving then return end
			-- small pause so the whole table picks up their chopsticks together
			task.wait(0.3 + math.random() * 0.6)
		end
		local hand = c.model:FindFirstChild("RightHand")
		local sticks = Assets:FindFirstChild("Chopsticks")
		local isDrink = c.ticket and c.ticket.menu == "음료"
		if isDrink then
			-- 음료는 젖가락 없이 캔을 손에 들고 후루룩
			sticks = nil
			local canPart = c.tableBowl and c.tableBowl:FindFirstChild("Can")
			if hand and canPart then
				for _, x in ipairs(canPart:GetChildren()) do if x:IsA("WeldConstraint") then x:Destroy() end end
				canPart.Anchored = false
				canPart.CFrame = hand.CFrame * CFrame.new(0, -0.35, -0.25)
				local w = Instance.new("WeldConstraint"); w.Part0 = hand; w.Part1 = canPart; w.Parent = canPart
				canPart.Parent = c.model
			end
		end
		if hand and sticks then
			sticks = sticks:Clone()
			-- held in the fist, sticks running out past the fingers
			local grip = hand.CFrame * CFrame.new(0, -0.15, -0.05) * CFrame.Angles(math.rad(-160), 0, math.rad(-10)) * CFrame.new(0, 0.4, 0)
			sticks:PivotTo(grip)
			local main = sticks.PrimaryPart
			local w = Instance.new("Weld"); w.Part0 = hand; w.Part1 = main; w.C0 = hand.CFrame:Inverse() * main.CFrame; w.Parent = main
			sticks.Parent = c.model
		end
		c.model:SetAttribute("Eating", true)            -- TwoHandHold (client) moves the arm bowl -> mouth
		-- the food in the bowl disappears a little at a time
		local food = {}
		if c.tableBowl and not isDrink then for _, p in ipairs(c.tableBowl:GetDescendants()) do if p:IsA("MeshPart") and p.Name:sub(1, 4) ~= "Skin" then table.insert(food, p) end end end
		local nextSip = os.clock() + 1
		for i = #food, 2, -1 do local j = math.random(1, i); food[i], food[j] = food[j], food[i] end
		local toEat = math.floor(#food * 0.85)
		local tEnd = os.clock() + C.EatTime
		local nextChat = os.clock() + 4 + math.random() * 6
		local eaten = 0
		while c.alive and os.clock() < tEnd do
			task.wait(0.5)
			local due = math.floor(toEat * (1 - (tEnd - os.clock()) / C.EatTime))
			while eaten < due do eaten += 1; local p = food[eaten]; if p and p.Parent then p:Destroy() end end
			if isDrink and os.clock() > nextSip then nextSip = os.clock() + 3 + math.random() * 2; sfx("Slurp", hand or c.root, 0.5, 40) end
			if os.clock() > nextChat then nextChat = os.clock() + 8 + math.random() * 8; if math.random() < 0.6 then chat(c, CHAT_EAT, false) end end
		end
		if c.model then c.model:SetAttribute("Eating", nil) end
		if isDrink and c.model then local cp = c.model:FindFirstChild("Can"); if cp then cp:Destroy() end end   -- 다 마신 캔은 치움
		c.doneEating = true
		-- friends leave together (but nobody waits forever)
		if c.group and c.alive then
			local t0 = os.clock()
			local said = false
			while c.alive and os.clock() - t0 < 30 do
				local waiting = false
				for _, m in ipairs(c.group.members) do
					if m ~= c and m.alive and not m.leaving and m.seatRec and not m.doneEating then waiting = true end
				end
				if not waiting then break end
				if not said then said = true; say(c, "천천히 먹어~", false); task.delay(2.5, function() if c.alive and not c.leaving then say(c, nil) end end) end
				task.wait(1)
			end
		end
		if c.alive then leave(c, false) end
	end)
	return true
end

local function runCustomer(c)
	local menu, side
	if c.tutReg then
		-- (11/19) 튜토리얼 손님: 계산대 바로 앞에 나타나서 그릇 채운 채로 바로 줄 서기
		menu = weighted(C.Menus, C.MenuWeights)
		side = C.SideMenus and C.SideMenus[menu] == true
		if not side then holdBowl(c); fillBowl(c) end
		task.wait(0.3)
	else
	-- 1) walk in and pick ingredients at the bar
	walkTo(c, DOOR_OUT)
	-- door bell: at most once every 5 s, however many customers walk in together
	local nowT = os.clock()
	if doorPart and nowT - (doorPart:GetAttribute("LastChime") or -99) >= 5 then
		doorPart:SetAttribute("LastChime", nowT)
		sfx("DoorChime", doorPart, 0.55, 70)
	end
	if c.superRich and announceRE then
		announceRE:FireAllClients({ kind = "rich", rarity = "divine", icon = "👑", title = "SUPER RICH MAN 등장!", text = string.format("VIP 라운지로 모셔요! 보상 %d배 + 룰렛 1회!", C.SuperRichMult or 15) })
	elseif c.rich and announceRE and os.clock() > richEventUntil and not (rushOn() and workspace:GetAttribute("RushRich") == true) then   -- (리치맨 러시아워 중엔 배너 도배 방지)   -- (during the event one banner covers everyone)
		announceRE:FireAllClients({ kind = "rich", title = "RICH MAN이 왔어요!", text = "Rich Man을 잘 응대하면 엄청난 보상이 있어요!" })
	end
	if c.headless and announceRE then
		announceRE:FireAllClients({ kind = "rich", icon = "🎃", title = "헤드리스맨이 왔어요!", text = "헤드리스맨을 응대하면 호박을 받을 수 있어요!" })
	end
	walkTo(c, DOOR_IN)
	if not c.alive then return end
	menu = weighted(C.Menus, C.MenuWeights)
	side = C.SideMenus and C.SideMenus[menu] == true
	if not side then
		walkTo(c, BOWL_SPOT + Vector3.new(math.random(-12, 12) / 10, 0, 0)); face(c, Vector3.new(0, 0, 1))
		task.wait(0.6)
		if not c.alive then return end
		holdBowl(c)
		task.wait(0.4)
		local spot = pick(BAR_SPOTS) + Vector3.new(0, 0, math.random(-10, 10) / 10)
		walkTo(c, spot); face(c, Vector3.new(1, 0, 0))
		say(c, nil)
		if c.group and math.random() < 0.6 then task.delay(math.random() * 2, function() chat(c, CHAT_BAR, false) end) end
		task.wait(4 + math.random() * 3)
		if not c.alive then return end
		fillBowl(c)
	else
		-- looks at the menu board for a moment, then goes to order
		if c.group and math.random() < 0.6 then chat(c, { "난 " .. menu .. "!", menu .. " 맛있겠다", "오늘은 " .. menu }, false) end
		task.wait(1 + math.random() * 1.5)
	end
	end   -- (11/19) 튜토리얼 손님 분기 끝
	-- 2) queue at the shorter register line
	-- 가장 짧은 줄 (비어 있는 칸이 많은 줄)
	local reg = REGISTERS[1]
	for _, r in ipairs(REGISTERS) do
		if (#r.queue - #r.line) > (#reg.queue - #reg.line) then reg = r end
	end
	if c.tutReg then reg = c.tutReg end   -- (11/19) 플레이어가 서 있는 계산대로
	if c.group then
		if c.group.reg and #c.group.reg.line < #c.group.reg.queue then reg = c.group.reg else c.group.reg = reg end
	end
	-- 줄이 꽉 찼으면 바로 나가지 말고 자리 날 때까지 조금 기다림 (러시아워 40초 / 평소 15초) (11/14)
	if #reg.line >= #reg.queue then
		lineWaiting += 1
		say(c, "줄 서려고 기다리는 중...", false)
		local t0 = os.clock()
		local limit = rushOn() and 40 or 15
		while c.alive and os.clock() - t0 < limit do
			task.wait(1)
			local found
			for _, r in ipairs(REGISTERS) do if #r.line < #r.queue then found = r; break end end
			if found then reg = found; break end
			if c.group and c.group.reg and #c.group.reg.line < #c.group.reg.queue then reg = c.group.reg; break end
		end
		lineWaiting -= 1
		if not c.alive then return end
		if #reg.line >= #reg.queue then say(c, "줄이 너무 길어요..."); task.wait(1.5); leave(c, true); return end
		say(c, nil)
	end
	table.insert(reg.line, c); c.queueReg = reg
	c.ticket = {
		id = 0, npc = c, menu = menu, side = side, spice = side and 0 or math.random(0, 4), rich = c.rich, superRich = c.superRich, headless = c.headless,
		weight = math.random(30, 90) * 10, state = "queue", correct = true,
	}
	say(c, nil)
	-- (11/18) 포스기가 읽는 주문 정보 (말풍선·저울 표시용. 정답 확인은 서버가 함)
	pcall(function()
		c.model:SetAttribute("OrderMenu", c.ticket.menu)
		c.model:SetAttribute("OrderSpice", c.ticket.spice)
		c.model:SetAttribute("OrderWeight", c.ticket.weight)
		c.model:SetAttribute("OrderSide", c.ticket.side == true)
		c.model:SetAttribute("OrderRich", (c.superRich and 2) or (c.rich and 1) or 0)
	end)
	-- move up the line as it shortens
	local myIndex
	while c.alive and c.ticket.state == "queue" do
		local idx = table.find(reg.line, c) or #reg.line
		if idx ~= myIndex then
			myIndex = idx
			walkTo(c, reg.queue[math.min(idx, #reg.queue)]); face(c, Vector3.new(0, 0, 1))
			if idx == 1 and not c.forcedFront then   -- (줄 감시가 이미 앞으로 당겨서 주문 받게 했으면 건너뜀)
				if c.ticket.side then
					say(c, string.format("%s 하나 주세요!", c.ticket.menu), true)
				else
					say(c, string.format("%s · %s\n%dg 주문할게요!", c.ticket.menu, C.SpiceShort[c.ticket.spice], c.ticket.weight), true)
				end
				patience(c, C.PatienceOrder, "order", function() leave(c, true) end)
			end
		end
		task.wait(0.3)
	end
end

----------------------------------------------------------------- 1) take order at the POS
for i, reg in ipairs(REGISTERS) do
	reg.line = {}
	local anchor = reg.posModel and (reg.posModel.PrimaryPart or reg.posModel:FindFirstChildWhichIsA("BasePart"))
	if anchor then
		local pp = Instance.new("ProximityPrompt")
		pp.Name = "TakeOrder"; pp.ActionText = "주문 받기"; pp.ObjectText = "계산대 " .. i   -- (11/21) E 한 번 = 주문 접수 (포스기 창 끔)
		pp.KeyboardKeyCode = Enum.KeyCode.E; pp.HoldDuration = 0; pp.MaxActivationDistance = 9; pp.RequiresLineOfSight = false   -- (손님용 F 주문하기 8보다 멀리서도 보이게)
		-- 계산대 앞이 붐빔 때(리치맨 이벤트) 근처 서빙·그릇·의자 E 버튼에 가려지지 않게 항상 보이기
		pp.Exclusivity = Enum.ProximityPromptExclusivity.AlwaysShow
		pp.Enabled = false; pp.Parent = anchor
		reg.prompt = pp
		reg.anchor = anchor
		-- 맨 앞에서 주문 기다리는 손님 (포스기 말풍선이 보고 붙음)
		local fv = anchor:FindFirstChild("Front") or Instance.new("ObjectValue"); fv.Name = "Front"; fv.Parent = anchor
		reg.frontValue = fv
		anchor:SetAttribute("RegIndex", i)
		-- (11/18) E → 계산대 모드 열기. 실제 주문 접수는 포스기에서 맞게 결제했을 때(posRF)
		pp.Triggered:Connect(function(plr)
			if not near(plr, anchor.Position, 12) then return end
			-- (11/21) 예전처럼 E 한 번이면 맨 앞 손님 주문 접수 (포스기 창 안 띄움). 되돌리려면 아래 3줄 대신 POSReg/posRE open 사용
			local c = reg.line[1]
			if not c or not c.alive or c.waitStage ~= "order" then notify(plr, "손님을 기다리는 중이에요"); return end
			local perfect = c.orderReadyAt ~= nil and (os.clock() - c.orderReadyAt) <= 10
			reg.takeOrder(plr, { perfect = perfect, extra = perfect and math.floor(C.Reward.TakeOrder.Money * 0.2) or 0 })
		end)
		reg.takeOrder = function(plr, bonus)
			-- 계산대 두 개 사이에서 한 번에 둘 다 눌리는 것 방지 (11/14)
			local lt = plr:GetAttribute("LastTakeOrder")
			if lt and os.clock() - lt < 0.35 then return end
			local c = reg.line[1]
			if not c or not c.alive or c.waitStage ~= "order" then return end
			c.waitStage = nil
			plr:SetAttribute("LastTakeOrder", os.clock())
			table.remove(reg.line, 1); c.queueReg = nil
			local t = c.ticket
			t.id = nextTicket; nextTicket += 1
			t.state = "ordered"; t.orderedBy = plr
			t.kinds = c.bowlKinds
			handOver(c, reg)
			tickets[t.id] = t
			refreshBoard()
			reward(plr, "TakeOrder", (bonus and bonus.extra) or 0, (bonus and bonus.perfect) and "완벽 주문" or "주문 받기", richMult(t)); pumpkinBonus(plr, t)
			sfx("CashRegister", anchor, 0.6)
			notify(plr, string.format("주문 #%d 접수", t.id))
			-- go sit down
			local s = takeSeat(c)
			if not s then say(c, "자리가 없네요..."); task.wait(1.5); leave(c, true); return end
			s.reservedBy = c; c.seatRec = s; s.seat:SetAttribute("Reserved", true)
			freeGroupLeftovers(c.group)
			local pp2 = s.seat:FindFirstChild("SitPrompt"); if pp2 then pp2.Enabled = false end
			say(c, nil)
			c.model:SetAttribute("TicketId", t.id)      -- ServeGuide (client) points the carrier here
			task.spawn(function()
				local function goTo(rec)
					c.approachPt = nil
					local seatPos = rec.seat.Position
					local toTable = ((rec.top.Position - seatPos) * Vector3.new(1, 0, 1)).Unit
					-- VIP 소파: 미리 계산해둔 입구로 걸어가서 틈을 따라 미끄러져 들어감
					if rec.vip then
						local sl = slotEntry(rec)
						if sl then
							local ok = walkTo(c, sl.entry) or (c.alive and not c.leaving and walkTo(c, sl.entry))
							if ok and c.alive and not c.leaving then
								c.approachPt = c.root.Position
								glideTo(c, Vector3.new(sl.front.X, c.root.Position.Y, sl.front.Z), (sl.front - sl.entry) * Vector3.new(1, 0, 1))
								return
							end
							if not c.alive or c.leaving then return end
						end
					end
					if walkTo(c, Vector3.new(seatPos.X, seatPos.Y + 1.5, seatPos.Z) - toTable * 1.5) then return end
					if not c.alive or c.leaving then return end
					-- 자리가 좁아 길찾기가 안 닿는 경우(VIP 라운지 소파 등): 근처 닿는 곳까지 걸어간 뒤 직선으로 들어감 (순간이동 방지)
					local root = c.root
					local seatY = seatPos.Y + 1.5
					-- 좌석이 바라보는 방향(테이블 쪽) 기준으로 틈을 잡음 (테이블이 비스듬히 있어도 소파열과 나란히)
					local fwd = toTable
					do local lv = rec.seat.CFrame.LookVector * Vector3.new(1, 0, 1); if lv.Magnitude > 0.5 and lv.Unit:Dot(toTable) > 0.3 then fwd = lv.Unit end end
					local gap = math.clamp((rec.top.Position - seatPos):Dot(fwd) * 0.55, 1.2, 2.4)   -- 소파 앞면과 테이블 사이 틈의 가운데
					local front = Vector3.new(seatPos.X, seatY, seatPos.Z) + fwd * gap
					-- 1) 소파열 끝(테이블과 소파 사이 틈의 입구)까지 걸어간 뒤 옆으로 미끄러져 들어감
					do
						local along = Vector3.new(-fwd.Z, 0, fwd.X)
						local rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Exclude
						local ex = { c.model }
						for _, pl in ipairs(Players:GetPlayers()) do if pl.Character then table.insert(ex, pl.Character) end end
						local cf = workspace:FindFirstChild("Customers"); if cf then table.insert(ex, cf) end
						rp.FilterDescendantsInstances = ex
						local cands = {}
						for d = 3, 9 do table.insert(cands, d); table.insert(cands, -d) end
						for _, d in ipairs(cands) do
							local entry = front + along * d
							local clear = true
							for _, h in ipairs({ 0.3, 2.2 }) do
								local o = entry + Vector3.new(0, h, 0)
								if workspace:Raycast(o, (front + Vector3.new(0, h, 0)) - o, rp) then clear = false; break end
							end
							if clear then
								local path = PFS:CreatePath(AGENT)
								local ok = pcall(function() path:ComputeAsync(root.Position, entry) end)
								local wps = ok and path.Status == Enum.PathStatus.Success and path:GetWaypoints()
								if wps and #wps > 0 and ((wps[#wps].Position - entry) * Vector3.new(1, 0, 1)).Magnitude < 2 then
									if walkTo(c, entry) and c.alive and not c.leaving then
										c.approachPt = root.Position
										glideTo(c, Vector3.new(front.X, root.Position.Y, front.Z), (front - entry) * Vector3.new(1, 0, 1))
									end
									return
								end
							end
							if not c.alive then return end
						end
					end
					-- 2) 그래도 안 되면 주변에서 닿는 가장 가까운 곳까지
					for _, r in ipairs({ 3, 4.5, 6, 7.5 }) do
						local found
						for k = 0, 11 do
							local a = k / 12 * math.pi * 2
							local p = Vector3.new(seatPos.X + math.cos(a) * r, seatPos.Y + 1.5, seatPos.Z + math.sin(a) * r)
							local path = PFS:CreatePath(AGENT)
							local ok = pcall(function() path:ComputeAsync(root.Position, p) end)
							if ok and path.Status == Enum.PathStatus.Success then found = p; break end
						end
						if found then
							c.approachPt = found   -- 나갈 때 여기로 되돌아 나옴
							if walkTo(c, found) and c.alive then
								stepTo(c, Vector3.new(seatPos.X, seatPos.Y + 1.5, seatPos.Z) + toTable * 0.8, 4)
							end
							return
						end
						if not c.alive then return end
					end
				end
				goTo(s)
				if not c.alive or c.leaving then return end
				-- somebody (a player) is already in my chair: find another one instead of storming out
				local tries = 0
				while s.seat.Occupant and s.seat.Occupant ~= c.hum and tries < 3 do
					tries += 1
					say(c, "어, 누가 앉아있네...", false)
					releaseSeat(c)
					local ns = takeSeat(c)
					if not ns then break end
					ns.reservedBy = c; c.seatRec = ns; ns.seat:SetAttribute("Reserved", true)
					local pp3 = ns.seat:FindFirstChild("SitPrompt"); if pp3 then pp3.Enabled = false end
					s = ns
					task.wait(0.8)
					say(c, nil)
					goTo(s)
					if not c.alive or c.leaving then return end
				end
				if s.seat.Occupant and s.seat.Occupant ~= c.hum or not c.seatRec then
					say(c, "앉을 데가 없네요...", false); task.wait(1.5); leave(c, true); return
				end
				smoothSit(c, s)
				s.seat:Sit(c.hum)
				if c.superRich then say(c, pick({ "VIP석은 역시 편하군", "오늘 팀은 두뚩하게 줌시", "여기 음식이 그렇게 맛있다며?" }), false); task.delay(2.5, function() if c.alive and c.waitStage == "food" then say(c, "", true) end end) end
				c.foodWaitStart = patience(c, C.PatienceFood + (s.upstairs and 40 or 0) + (c.superRich and 40 or 0), "food", function() leave(c, true) end)
				say(c, "", true)
				if c.group then
					task.spawn(function()
						while c.alive and c.waitStage == "food" do
							task.wait(7 + math.random() * 9)
							if c.waitStage == "food" and math.random() < 0.55 then chat(c, CHAT_WAIT, true) end
						end
					end)
				end
				-- serve prompt on the customer
				local sp = Instance.new("ProximityPrompt")
				sp.Name = "Serve"; sp.ActionText = "서빙하기"; sp.ObjectText = "주문 #" .. t.id
				sp.KeyboardKeyCode = Enum.KeyCode.E; sp.HoldDuration = 0.3; sp.MaxActivationDistance = 8; sp.RequiresLineOfSight = false
				sp.Parent = c.root
				c.servePrompt = sp
				sp.Triggered:Connect(function(plr2)
					if not near(plr2, c.root.Position, 12) then return end
					local carrying = plr2:GetAttribute("CarryTicket")
					if not carrying then notify(plr2, "먼저 패스대에서 그릇을 들어주세요"); return end
					if not isCarrying(plr2, t.id) then
						local ids = CarryCfg.ids(plr2)
						if #ids == 1 then notify(plr2, string.format("들고 있는 건 #%d, 이 손님은 #%d예요", ids[1], t.id))
						else
							local s = {}
							for _, v in ipairs(ids) do table.insert(s, "#" .. v) end
							notify(plr2, string.format("이 손님은 #%d예요 · 들고 있는 그릇: %s", t.id, table.concat(s, ", ")))
						end
						return
					end
					serveTo(c, plr2)
				end)
			end)
		end
	end
end
-- (11/18) 포스기 결제: 메뉴·맵기가 손님 주문과 맞으면 접수. 틀리면 손님이 다시 말해줌
--   맞게 + 빨리(맨 앞에 선 뒤 10초 안) + 한 번에 = 「완벽 주문」 보너스
posRF.OnServerInvoke = function(plr, regIdx, npc, menu, spice)
	regIdx = tonumber(regIdx)
	local reg = regIdx and REGISTERS[regIdx]
	if not reg or not reg.anchor or plr:GetAttribute("POSReg") ~= regIdx then return false, "far" end
	if not near(plr, reg.anchor.Position, 16) then return false, "far" end
	local c = reg.line[1]
	if not c or not c.alive or c.waitStage ~= "order" or c.model ~= npc then return false, "gone" end
	local now = os.clock()
	if c.posLast and now - c.posLast < 0.4 then return false, "wait" end
	c.posLast = now
	local t = c.ticket
	if type(menu) ~= "string" then return false, "wrong" end
	local ok = (menu == t.menu) and (t.side or tonumber(spice) == t.spice)
	if not ok then
		c.posMistakes = (c.posMistakes or 0) + 1
		local want = t.side and t.menu or (t.menu .. " · " .. C.SpiceShort[t.spice])
		say(c, "아니에요! " .. want .. "요!", true)
		task.delay(1.8, function()
			if c.alive and c.waitStage == "order" then
				if t.side then say(c, string.format("%s 하나 주세요!", t.menu), true)
				else say(c, string.format("%s · %s\n%dg 주문할게요!", t.menu, C.SpiceShort[t.spice], t.weight), true) end
			end
		end)
		return false, "wrong"
	end
	local perfect = (c.posMistakes or 0) == 0 and c.orderReadyAt ~= nil and (now - c.orderReadyAt) <= 10
	local extra = perfect and math.floor(C.Reward.TakeOrder.Money * 0.2) or 0   -- (11/21: 0.6 → 0.2) 결제 버튼만 누르면 돼서 거의 매번 완벽 주문
	reg.takeOrder(plr, { perfect = perfect, extra = extra })
	if t.state == "ordered" then return true, t.id, perfect end
	return false, "gone"
end
posRE.OnServerEvent:Connect(function(plr, action)
	if action == "close" then plr:SetAttribute("POSReg", nil) end
end)
-- 줄 감시 (11/15): 맨 앞 손님이 계산대까지 못 와서 줄 전체가 멈추는 것 방지
--   · 죽었거나 이미 다른 단계로 간 손님은 줄에서 빼기
--   · 맨 앞 손님이 12초 넘게 '주문할게요' 상태가 아니면 → 계산대 앞으로 옮기고 바로 주문 받게
task.spawn(function()
	while true do
		task.wait(2)
		for _, reg in ipairs(REGISTERS) do
			local ghosts = {}
			for i = #reg.line, 1, -1 do
				local q = reg.line[i]
				if not q or not q.alive or not q.ticket or q.ticket.state ~= "queue" or not (q.model and q.model.Parent) then
					table.remove(reg.line, i)
					if q and q.queueReg == reg then q.queueReg = nil end
				else
					-- 줄에 이름만 있고 실제로는 멀리(30스터드+) 20초 넘게 있는 손님 → 내보내서 자리 비움
					local spot = reg.queue[math.min(i, #reg.queue)]
					local far = (not q.root) or (q.root.Position - spot).Magnitude > 30
					if far then
						q.farSince = q.farSince or os.clock()
						if os.clock() - q.farSince > 20 then table.insert(ghosts, q) end
					else
						q.farSince = nil
					end
				end
			end
			for _, q in ipairs(ghosts) do
				warn("[CustomerService] 줄에만 있고 멀리 있던 손님 정리 (계산대 " .. tostring(table.find(REGISTERS, reg)) .. ")")
				task.spawn(leave, q, false)
			end
			local c = reg.line[1]
			if c and c.waitStage ~= "order" then
				c.frontSince = c.frontSince or os.clock()
				if os.clock() - c.frontSince > 12 then
					c.frontSince = nil
					c.forcedFront = true
					local spot = reg.queue[1]
					pcall(function()
						local y = c.root.Position.Y
						if math.abs(y - spot.Y) > 6 then y = spot.Y end   -- (다른 층에 있으면 1층 계산대 높이로)
						c.root.CFrame = CFrame.lookAt(Vector3.new(spot.X, y, spot.Z), Vector3.new(spot.X, y, spot.Z + 1))
						c.hum:MoveTo(c.root.Position)
					end)
					local tk = c.ticket
					if tk.side then say(c, string.format("%s 하나 주세요!", tk.menu), true)
					else say(c, string.format("%s · %s\n%dg 주문할게요!", tk.menu, C.SpiceShort[tk.spice], tk.weight), true) end
					patience(c, C.PatienceOrder, "order", function() leave(c, true) end)
					warn("[CustomerService] 줄 맨 앞 손님이 막혀서 계산대로 옮김 (계산대 " .. tostring(table.find(REGISTERS, reg)) .. ")")
				end
			elseif c then
				c.frontSince = nil
			end
		end
	end
end)
