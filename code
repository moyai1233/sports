makePickup = function(t)
	local bowl = t.bowl
	if not (bowl and bowl.PrimaryPart) then return end
	local tag = bowl.PrimaryPart:FindFirstChild("Tag")
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "Pickup"; pp.ActionText = t.takeout and "포장 들기" or "그릇 들기"; pp.ObjectText = string.format(t.takeout and "#%d 🥡 %s (포장)" or "#%d %s", t.id, t.menu)
	pp.KeyboardKeyCode = Enum.KeyCode.E; pp.HoldDuration = 0.25; pp.MaxActivationDistance = 7; pp.RequiresLineOfSight = false
	pp.Parent = bowl.PrimaryPart
	pp.Triggered:Connect(function(plr)
		if t.state ~= "ready" or not near(plr, bowl.PrimaryPart.Position, 12) then return end
		-- 들 수 있는 개수 안에서 빈 칸 (CarryConfig.capacity: 1 / 2 / 3 / 쟁반 5 / 카트 8)
		local cap = CarryCfg.capacity(plr)
		local slotAttr
		for k = 1, cap do if not plr:GetAttribute(CARRY_SLOTS[k]) then slotAttr = CARRY_SLOTS[k]; break end end
		if not slotAttr then
			local msg
			if plr:GetAttribute("CartOn") then msg = "서빙 카트가 꽉 찼어요 (8개)"
			elseif cap >= CarryCfg.TrayMax then msg = "쟁반 두 개가 꽉 찼어요 (4개) · 서빙 카트로 8개까지!"
			elseif cap == 3 then msg = "양손도 머리도 꽉 찼어요 (쟁반 서빙 업그레이드로 4개까지!)"
			elseif cap == 2 then msg = "양손이 꽉 찼어요 (머리 서빙 업그레이드로 3개까지!)"
			else msg = "이미 그릇을 들고 있어요 (양손 서빙 업그레이드로 2개까지!)" end
			notify(plr, msg)
			return
		end
		local ch = plr.Character
		local hand = ch and (ch:FindFirstChild("RightHand") or ch:FindFirstChild("Right Arm"))
		if not hand then return end
		passUsed[t.slot] = nil; t.slot = nil
		local hum = ch:FindFirstChildOfClass("Humanoid"); if hum then hum:UnequipTools() end
		pp:Destroy(); if tag then tag.Enabled = true end
		t.state = "carried"; t.carrier = plr
		do
			local st = skinOf(plr, "bowl")
			if st and bowl:FindFirstChild("Broth") and bowl.PrimaryPart then pcall(SkinStyle.apply, bowl.PrimaryPart, st, { gems = 10 }) end
		end
		plr:SetAttribute(slotAttr, t.id)
		carryLayout(plr)
		refreshBoard()
		notify(plr, string.format("#%d 손님에게 가져다주세요", t.id))
	end)
	refreshBoard()
	return true
end

-- 든 음식 그릇 내려놓기: 마지막에 든 그릇을 패스대 빈 칸에 돌려놓음 (주문은 그대로, 누구나 다시 들 수 있음)
--   ServerStorage.PutBackCarry:Invoke(player) -> ok, 메시지   (BowlService의 내려놓기 버튼에서 호출)
local function putBack(plr)
	local id
	for k = #CARRY_SLOTS, 1, -1 do local v = plr:GetAttribute(CARRY_SLOTS[k]); if v then id = v; break end end
	local t = id and tickets[id]
	if not t or t.state ~= "carried" or t.carrier ~= plr or t.cancelled or not (t.bowl and t.bowl.Parent and t.bowl.PrimaryPart) then return false, "내려놓을 그릇이 없어요" end
	if id < 0 then t.bowl:Destroy(); tickets[id] = nil; releaseCarry(plr, id); return true end   -- Studio 테스트 그릇
	local slot = freePassSlot()
	if not slot then return false, "패스대가 꽉 차서 내려놓을 수 없어요" end
	-- 들고 있던 그릇을 그대로 옮기면 플레이어 화면에서는 허공에 남음 → 서빙 때와 같이 복사본을 패스대에 놓고 원본은 지움
	t.bowl = placeOnTable(t.bowl, CFrame.new(PASS_SLOTS[slot]))
	passUsed[slot] = t; t.slot = slot; t.state = "ready"; t.carrier = nil
	releaseCarry(plr, id)
	makePickup(t)
	refreshBoard()
	return true, string.format("#%d 그릇을 패스대에 내려놨어요", t.id)
end
