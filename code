	-- dries up slowly if nobody sweeps it
	task.delay(FLOOR_FADE, function()
		if done then return end
		for i = 1, 10 do
			if done then return end
			for _, p in ipairs(m:GetChildren()) do if p:IsA("BasePart") then p.Transparency = math.min(1, p.Transparency + 0.08) end end
			task.wait(0.5)
		end
		finish()
	end)
end

